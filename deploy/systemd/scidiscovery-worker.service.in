# SciDiscovery worker broker
[Unit]
Description=SciDiscovery worker broker
Wants=network-online.target
After=local-fs.target network-online.target

[Service]
Type=simple
User=@CONTROL_USER@
Group=@CONTROL_GROUP@
SupplementaryGroups=@PYTHON_ACCESS_GROUP@
UMask=0007
WorkingDirectory=@PROJECT_ROOT@
Environment=PYTHONPATH=@PYTHONPATH@
Environment=PYTHONNOUSERSITE=1
RuntimeDirectory=scidiscovery-worker
RuntimeDirectoryMode=0770
ExecStart=@PYTHON@ -m scidiscovery.artifact_agent.interfaces.mcp_worker_daemon --project-root @PROJECT_ROOT@ --state-root @STATE_ROOT@ --socket @WORKER_SOCKET@ --task-secret-file @TASK_SECRET@
Restart=on-failure
RestartSec=2s
TasksMax=128
MemoryMax=3G
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=@STATE_ROOT@ @RUNTIME_ROOT@
ProtectControlGroups=true
ProtectKernelModules=true
ProtectKernelTunables=true
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6 AF_NETLINK
LockPersonality=true

[Install]
WantedBy=multi-user.target
