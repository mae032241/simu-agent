# SciDiscovery control service
[Unit]
Description=SciDiscovery control service
After=local-fs.target

[Service]
Type=simple
User=@CONTROL_USER@
Group=@CONTROL_GROUP@
SupplementaryGroups=@PYTHON_ACCESS_GROUP@
UMask=0007
WorkingDirectory=@PROJECT_ROOT@
Environment="PYTHONPATH=@PYTHONPATH@"
Environment=PYTHONNOUSERSITE=1
Environment="SCID_AGENT_SETTINGS_FILE=@AGENT_SETTINGS_FILE@"
RuntimeDirectory=scidiscovery
RuntimeDirectoryMode=0770
ExecStartPre="@PYTHON@" -m scidiscovery.runtime_identity verify --manifest "@RUNTIME_IDENTITY@"
ExecStart="@PYTHON@" -m scidiscovery.artifact_agent.interfaces.mcp_daemon --project-root "@PROJECT_ROOT@" --state-root "@STATE_ROOT@" @LOCAL_WORKSPACE_ARGS@ --socket "@CONTROL_SOCKET@" --approval-secret-file "@APPROVAL_SECRET@" --approval-base-url "http://127.0.0.1:@APPROVAL_PORT@" --worker-backend "@WORKER_BACKEND@" --runtime-summary "/run/scidiscovery/runtime-summary.json" @PLUGIN_CONFIG_ARGS@
Restart=on-failure
RestartSec=2s
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths="@STATE_ROOT@" @LOCAL_WORKSPACE_ACCESS@ "@RUNTIME_ROOT@"
ProtectControlGroups=true
ProtectKernelModules=true
ProtectKernelTunables=true
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6 AF_VSOCK
LockPersonality=true

[Install]
WantedBy=multi-user.target
