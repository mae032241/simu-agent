+    report['evidence'] = [dict(source_key='independent_' + name, source_type='runtime_output',
+        title='Exact calculation ' + name, locator='calculation_records:' + name) for name in ('first', 'second')]
+    for gate in report['gates'].values():
+        if isinstance(gate, dict) and gate.get('evidence_keys'):
+            gate['evidence_keys'] = ['independent_first', 'independent_second']
+    if tamper == 'alias':
