+def mcp_call(worker, name, arguments):
+    return MCPRouter(worker, name='analysis-scope').handle({'jsonrpc': '2.0', 'id': 1,
+        'method': 'tools/call', 'params': {'name': name, 'arguments': arguments}})
+
