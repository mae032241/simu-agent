+    planned = {check.check_key: check for dimension in (plan.numerical, plan.physical, plan.experimental)
+               for check in dimension.checks if check.evaluation_mode == "deterministic_threshold"}
+    if spec is not None and report.comparison_spec_sha256 != canonical_sha256(spec):
+        raise declared_violation("metric report differs from its exact comparison specification")
+    specifications = {item.comparison_key: item for item in spec.comparisons} if spec is not None else {}
+    if len({item.comparison_key for item in report.comparisons}) != len(report.comparisons):
+        raise declared_violation("metric comparison identities must be unique")
+    outcomes: dict[str, list[bool]] = {}
+    incomplete = any(item.required and item.status != "pass" for item in report.comparisons)
+    if spec is not None:
+        results = {item.comparison_key for item in report.comparisons}
+        incomplete |= any(item.required and item.comparison_key not in results for item in spec.comparisons)
+    for result in report.comparisons:
+        comparison = specifications.get(result.comparison_key)
+        if spec is not None and comparison is None:
+            raise declared_violation("metric report names a comparison outside its specification")
+        metrics = {item.operator_key: item for item in result.metrics}
+        checks = {item.operator_key: item for item in result.checks}
+        if len(metrics) != len(result.metrics) or len(checks) != len(result.checks):
+            raise declared_violation("metric operator identities must be unique within a comparison")
+        if comparison is not None:
+            bindings = []
+            for operator in comparison.operators:
+                check = planned.get(operator.validation_check_key)
+                if check is None:
+                    continue
+                matches = _planned_threshold_matches(check, operator.kind, operator.threshold)
+                if not matches and not method_changes:
+                    raise declared_violation("changed calculation method requires method_changes; it cannot satisfy the original planned check", path="$.method_changes")
+                bindings.append((check.check_key, operator.operator_key, operator.kind, operator.threshold, matches))
+        else:
+            bindings = []
+            for key, check_result in checks.items():
+                metric = metrics.get(key)
+                if metric is None:
+                    continue
+                candidates = [check for check in planned.values()
+                              if check.check_key in report.covered_validation_check_keys
+                              and _planned_threshold_matches(check, metric.kind, check_result.threshold)]
+                # The report does not retain check-key bindings. Equal metric/threshold
+                # signatures for multiple plan checks cannot establish correspondence.
+                if len(candidates) == 1:
+                    bindings.append((candidates[0].check_key, key, metric.kind, check_result.threshold, True))
+        for check_key, operator_key, kind, threshold, matches in bindings:
+            metric, checked = metrics.get(operator_key), checks.get(operator_key)
+            actual = (matches and metric is not None and checked is not None and threshold is not None
+                      and result.required and result.status == "pass"
+                      and (comparison is None or comparison.required)
+                      and metric.comparison_key == result.comparison_key == checked.comparison_key
+                      and metric.kind == kind and metric.status == "available" and metric.unit == threshold.unit
+                      and checked.status == "pass" and checked.observed_value == metric.value
+                      and canonical_json(checked.threshold) == canonical_json(threshold))
+            if actual:
+                value = abs(metric.value) if threshold.comparison == "abs_le" else metric.value
+                actual = value >= threshold.value if threshold.comparison == "ge" else value <= threshold.value
+            outcomes.setdefault(check_key, []).append(bool(actual))
+    return {key for key, values in outcomes.items() if values and all(values)}, incomplete
