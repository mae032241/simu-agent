+    plans = tuple(item for item in portfolio.validation_plans if item.experiment_key == diagnosis.experiment_key and item.plan_key == diagnosis.plan_key)
+    if len(plans) != 1 or diagnosis.study_kind != portfolio.study_kind:
+        raise declared_violation("analysis must identify the exact study and validation plan")
+    if portfolio.objective_key is not None:
+        if diagnosis.objective_assessment is None or diagnosis.objective_assessment.objective_key != portfolio.objective_key:
+            raise declared_violation("analysis objective differs from plan", path="$.objective_assessment")
+    elif diagnosis.objective_assessment is not None:
+        raise declared_violation("analysis cannot invent a plan objective key", path="$.objective_assessment")
+    records = {item.record_key: item for item in diagnosis.calculation_records}
+    numeric_gates = (diagnosis.gates.numerical_validity, diagnosis.gates.observation, diagnosis.gates.physical_interpretation)
+    decisive_evidence = {key for gate in numeric_gates if gate.status == "pass" for key in gate.evidence_keys}
+    if diagnosis.objective_assessment is not None and diagnosis.objective_assessment.status == "pass":
+        decisive_evidence.update(diagnosis.objective_assessment.evidence_keys)
+    used_record_keys = {item.locator.split(":", 1)[1] for item in diagnosis.evidence if item.source_key in decisive_evidence and item.locator.startswith("calculation_records:")}
+    reports = {}
+    covered_checks = set()
+    incomplete = False
+    try:
+        for record in records.values():
+            if record.status != "computed":
+                continue
+            report = CurveConsistencyReport.model_validate_json(canonical_json(record.result), strict=True)
+            spec = CurveComparisonSpec.model_validate_json(canonical_json(record.request["comparison_spec"]), strict=True)
+            reports[record.record_key] = report
+            if record.record_key in used_record_keys:
+                covered, missing = _actual_check_coverage(plans[0], report, spec, method_changes=diagnosis.method_changes)
+                covered_checks.update(covered)
+                incomplete |= missing
+    except (ValidationError, KeyError) as error:
+        raise declared_violation("calculation result or request is not a valid bounded curve report", path="$.calculation_records") from error
+    if metric_report is not None:
+        if metric_report.validation_scope != "complete_plan" or metric_report.validation_plan_sha256 != canonical_sha256(plans[0]):
+            raise declared_violation("optional metric report differs from exact validation plan")
+        if any(item.source_key in decisive_evidence and _is_metric_locator(item.locator, metric_alias) for item in diagnosis.evidence):
+            covered, missing = _actual_check_coverage(plans[0], metric_report, metric_spec, method_changes=diagnosis.method_changes)
+            covered_checks.update(covered)
+            incomplete |= missing
+    if (diagnosis.overall_verdict == "pass" or diagnosis.claim_allowed) and (incomplete
+            or not set(deterministic_validation_check_keys(plans[0])).issubset(covered_checks)):
+        raise declared_violation("unperformed required quantitative checks cannot pass", path="$.overall_verdict")
+    for evidence in diagnosis.evidence:
+        if evidence.locator.startswith("calculation_records:"):
+            key = evidence.locator.split(":", 1)[1]
+            if key not in records:
+                raise declared_violation("analysis references an unknown calculation", path="$.evidence")
+            if records[key].status != "computed":
+                for gate in numeric_gates:
+                    if gate.status in {"pass", "fail"} and evidence.source_key in gate.evidence_keys:
+                        raise declared_violation("unfinished calculation cannot support a decisive numeric gate", path="$.gates")
+                objective = diagnosis.objective_assessment
+                if (objective is not None and objective.status in {"pass", "fail"} and evidence.source_key in objective.evidence_keys
+                        or any(item.outcome in {"supports", "contradicts"} and evidence.source_key in item.evidence_keys
+                               for item in diagnosis.hypothesis_assessments)):
+                    raise declared_violation("unfinished calculation cannot support a decisive assessment")
+    if diagnosis.objective_assessment is not None:
+        assessment = diagnosis.objective_assessment
+        cited_records = {item.locator.split(":", 1)[1] for item in diagnosis.evidence
+                         if item.source_key in assessment.evidence_keys and item.locator.startswith("calculation_records:")}
+        comparisons = [comparison for key, report in reports.items() if key in cited_records for comparison in report.comparisons]
+        if metric_report is not None and any(item.source_key in assessment.evidence_keys
+                and _is_metric_locator(item.locator, metric_alias) for item in diagnosis.evidence):
+            comparisons.extend(metric_report.comparisons)
+        available = {item.comparison_key for item in comparisons
+                     if assessment.status not in {"pass", "fail"} or item.status in {"pass", "fail"}}
+        if not set(assessment.comparison_keys).issubset(available):
+            raise declared_violation("objective comparison lacks a completed calculation", path="$.objective_assessment")
+        if assessment.status == "pass":
+            successful = {item.comparison_key for item in comparisons if item.status == "pass"}
+            unsuccessful = {item.comparison_key for item in comparisons if item.status != "pass"}
+            if not set(assessment.comparison_keys).issubset(successful - unsuccessful):
+                raise declared_violation("objective comparison success requires actual passing calculation", path="$.objective_assessment")
