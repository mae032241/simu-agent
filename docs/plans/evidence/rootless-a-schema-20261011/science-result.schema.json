{
  "type": "object",
  "properties": {
    "summary": {
      "type": "string",
      "minLength": 1
    },
    "scientific_result": {
      "type": "string",
      "minLength": 1
    },
    "limitations": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "next_action": {
      "type": "string",
      "enum": [
        "continue_w",
        "revise_h",
        "extract",
        "wait",
        "finish"
      ]
    },
    "route_reason": {
      "type": "string",
      "minLength": 1
    },
    "candidate_recommendation": {
      "type": [
        "string",
        "null"
      ],
      "maxLength": 80,
      "description": "Optional scientific recommendation: one listed candidate ID, or null when unknown."
    }
  },
  "required": [
    "summary",
    "scientific_result",
    "limitations",
    "next_action",
    "route_reason"
  ],
  "additionalProperties": false
}
