+def router(**methods):
+    facade = SimpleNamespace(runs=SimpleNamespace(), session_key=None,
+        engineering_diagnostics=SimpleNamespace(capture=Mock()), _instance_id=lambda: "fixture", **methods)
+    return RootMCPRouter(facade)
