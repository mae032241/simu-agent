+def cite(report, alias, key="calculation"):
+    report["source_references"] = []
+    report["calculation_records"] = []
+    report["evidence"].append(dict(source_key=key, title="Saved analysis evidence",
+        source_type="runtime_output", locator=alias))
+    return report
+
